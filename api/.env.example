# Required for local setup
REDIS_URL=redis://localhost:6379
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Common app settings
NODE_ENV=development
PORT=3000
SQLITE_DATABASE_PATH=./data/transferly.sqlite
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
FINANCE_RECONCILIATION_SIGNING_SECRET=replace-with-a-distinct-long-random-secret
JWT_EXPIRES_IN_SECONDS=3600
JWT_CLOCK_SKEW_SECONDS=30
AUTH_SESSION_TTL_SECONDS=604800
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
BOT_API_HMAC_SECRET=replace-with-a-long-random-bot-api-hmac-secret
BOT_API_HMAC_REQUIRED=true
BOT_API_HMAC_MAX_AGE_MS=300000
BOT_API_HMAC_REPLAY_PROTECTION=true
BOT_API_HMAC_REPLAY_STORE=redis
BOT_API_HMAC_REPLAY_KEY_PREFIX=transferly:bot-api-replay

# PayPal
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ONLY_PRODUCTION_MVP=true

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=https://transferly-nine.vercel.app
MINI_APP_URL=https://transferly-nine.vercel.app

# Telegram Owner & Admin Configuration
# Set Telegram user IDs here to grant owner/admin access (numeric IDs from Telegram)
# Multiple IDs should be comma-separated
# Example: 123456789,987654321
TRANSFERLY_OWNER_TELEGRAM_USER_IDS=
TRANSFERLY_ADMIN_TELEGRAM_USER_IDS=

# Optional auth
USER_API_TOKENS=

# Optional queue/development controls
INLINE_QUEUE_MODE=false
JOB_WAIT_MS=30000

# Private generated asset storage and expiry cleanup
GENERATED_ASSET_STORAGE_PATH=./data/generated-assets
GENERATED_ASSET_MAX_BYTES=10485760
GENERATED_ASSET_CLEANUP_INTERVAL_MS=21600000
GENERATED_ASSET_CLEANUP_BATCH_SIZE=100
# Keep false until a reviewed storage reconciliation run confirms the target path.
GENERATED_ASSET_ORPHAN_DELETE_ENABLED=false
GENERATED_ASSET_DOWNLOAD_TTL_SECONDS=300
ORDER_PROCESSING_LOCK_TTL_MS=900000
POINT_RESERVATION_TTL_MS=86400000
POINT_RESERVATION_EXPIRY_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_INTERVAL_MS=900000
PAYMENT_RECONCILIATION_INVOICE_LIMIT=25
PAYMENT_RECONCILIATION_PAYOUT_LIMIT=25
POINT_RESERVATION_EXPIRY_BATCH_SIZE=100

# Manual points funding destination seed. Keep real account details server-side only.
POINTS_TO_NAIRA_RATE=1
DEFAULT_SERVICE_POINT_CHARGE=250
POINTS_FUNDING_DESTINATION_ACTIVE=true
POINTS_FUNDING_BANK_PROVIDER=Configured Bank
POINTS_FUNDING_ACCOUNT_NAME=TRANSFERLY CONFIG REQUIRED
POINTS_FUNDING_ACCOUNT_NUMBER=0000000000
POINTS_FUNDING_PAYMENT_NOTE=Include your Transferly payment reference in the bank transfer narration.
POINTS_FUNDING_INSTRUCTIONS=Transfer exactly the amount shown. 1 Transferly Point equals ₦1.
PAYMENT_VERIFICATION_ENABLED=false
PAYMENT_AUTO_APPROVAL_ENABLED=false
PAYMENT_AUTO_APPROVAL_MAX_AMOUNT_MINOR=0
PAYMENT_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
OPAY_WEBHOOK_SECRET=

# Fraud, risk & account protection engine
RISK_ENGINE_ENABLED=true
RISK_REVIEW_ENABLED=true
AUTO_RESTRICTION_ENABLED=false
HIGH_RISK_AUTO_REVIEW_ENABLED=true
MAX_FUNDING_ATTEMPTS_PER_HOUR=5
MAX_DAILY_FUNDING_AMOUNT=25000000
LARGE_FUNDING_THRESHOLD=10000000
MAX_SERVICE_ACTIONS_PER_MINUTE=20
MAX_SERVICE_ACTIONS_PER_HOUR=200
MAX_REFUND_REQUESTS_PER_DAY=5
MAX_FAILED_PAYMENT_ATTEMPTS=5
RAPID_POINT_CONSUMPTION_THRESHOLD=25000
LARGE_ADMIN_ADJUSTMENT_THRESHOLD=10000
RISK_SIGNAL_RETENTION_DAYS=365
RISK_CASE_RETENTION_DAYS=1095

# Optional service rollout controls (comma-separated manifest feature flags)
SERVICE_FEATURE_FLAGS=
# Optional provider rollout controls. Empty enables default-enabled modules;
# a non-empty value is an explicit comma-separated allowlist.
PAYMENT_PROVIDER_FEATURE_FLAGS=paypal

# Optional risk/rate-limit controls
MAX_SINGLE_PAYOUT=1000
DAILY_PAYOUT_LIMIT=5000
MAX_PAYOUTS_PER_HOUR=5
# Keep at 0 to require manual approval for all payouts; set an explicit minor-unit
# limit only after risk, ledger, and provider execution controls are verified.
PAYOUT_AUTO_APPROVAL_MAX_CENTS=0
HIGH_RISK_COUNTRIES=RU,IR,KP,SY
HIGH_RISK_CURRENCIES=RUB,IRR,KPW,SYP
SUSPICIOUS_INVOICE_KEYWORDS=crypto,investment,loan,casino,gift card
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
API_REQUEST_TIMEOUT_MS=30000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
FINANCIAL_RATE_LIMIT_MAX=30
FINANCIAL_RATE_LIMIT_WINDOW_MS=60000
FUNDING_RATE_LIMIT_MAX=10
FUNDING_RATE_LIMIT_WINDOW_MS=3600000
ADMIN_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
PROVIDER_INCIDENT_FAILED_WEBHOOK_THRESHOLD=3
PROVIDER_INCIDENT_OPEN_ISSUE_THRESHOLD=2
PAYMENT_PROVIDER_KILL_SWITCHES=
# Comma-separated provider:corridor entries, e.g. paypal:ng:ngn or paypal:*:*.
PAYMENT_CORRIDOR_KILL_SWITCHES=
TRANSFERLY_BACKUP_LOCATION=
TRANSFERLY_BACKUP_LAST_SUCCESS_AT=
TRANSFERLY_BACKUP_RESTORE_VERIFIED_AT=
TRANSFERLY_BACKUP_EVIDENCE_MAX_AGE_HOURS=168
TRANSFERLY_BACKUP_RPO=
TRANSFERLY_BACKUP_RTO=
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://transferly-nine.vercel.app

# Optional provider integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_PAYOUTS_ENABLED=false
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_WEBHOOK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
CRYPTO_COMMERCE_API_KEY=
CRYPTO_COMMERCE_WEBHOOK_SECRET=
# Discovery-only providers: credentials do not enable API calls or money movement.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com
CASH_APP_API_KEY=
CASH_APP_ENVIRONMENT=sandbox
# EMAIL_DELIVERY_WEBHOOK_URL=https://example.com/email-webhook

# Optional PayPal sandbox smoke test
PAYPAL_SANDBOX_INVOICE_RECIPIENT_EMAIL=
PAYPAL_SANDBOX_PAYOUT_RECEIVER=
PAYPAL_SANDBOX_INVOICE_AMOUNT=12.50
PAYPAL_SANDBOX_PAYOUT_AMOUNT=5.00
PAYPAL_SANDBOX_CURRENCY=USD

# Optional demo seed overrides
SEED_USER_ID=demo-user
SEED_USER_EMAIL=demo@transferly.local
SEED_USER_NAME=Demo User
